# Optional developer environment overrides.
#
# Horizon Trace user settings, including API keys, live in:
# ~/.horizon/settings.json
#
# These variables are only for advanced local runs, tests, or deployments.

HORIZON_HOME=~/.horizon
HORIZON_DATA_DIR=~/.horizon
HORIZON_CONFIG_PATH=~/.horizon/settings.json
HORIZON_DB_PATH=~/.horizon/horizon.db
HORIZON_HOST=127.0.0.1
HORIZON_PORT=8765
